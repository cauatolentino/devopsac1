{
  "uid": "arquitetura-b1",
  "title": "B1 - ASRs da Arquitetura (Grupo 12)",
  "description": "Cada painel valida uma decisao arquitetural (ADR). Metrica tecnica x evidencia arquitetural.",
  "tags": ["b1", "arquitetura", "asr"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Core coletado (up)",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"core\"}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "FORA"}, "1": {"text": "UP"}}}],
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2, "type": "stat", "title": "ADR-004 · Eventos pendentes no outbox (agora)",
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "gamificacao_outbox_pendentes"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3, "type": "stat", "title": "ADR-003 · % recomendacoes degradadas (5 min)",
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * sum(increase(gamificacao_recomendacao_total{origem=\"catalogo-padrao\"}[5m])) / clamp_min(sum(increase(gamificacao_recomendacao_total[5m])), 1)"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 50}]}}, "overrides": []},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4, "type": "stat", "title": "ADR-001 · p95 do ranking (gatilho: 300 ms)",
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/forum/engajamento\"}[5m])))"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.3}]}}, "overrides": []},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5, "type": "stat", "title": "ADR-005 · eventos IoT rejeitados (15 min)",
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(gamificacao_iot_eventos_total{resultado=\"rejeitado\"}[15m])) or vector(0)"}],
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 6, "type": "timeseries", "title": "ADR-004 · Outbox pendentes x mensagens prontas no RabbitMQ",
      "description": "Broker fora: outbox sobe e a premiacao continua respondendo. Broker volta: outbox zera (sem perda).",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "gamificacao_outbox_pendentes", "legendFormat": "pendentes no outbox (Core)"},
        {"refId": "B", "expr": "sum(rabbitmq_queue_messages_ready)", "legendFormat": "prontas nas filas (RabbitMQ)"}
      ],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}, "overrides": []}
    },
    {
      "id": 7, "type": "timeseries", "title": "ADR-003 · Recomendacoes por origem (req/s)",
      "description": "ia-recomendacao = resposta da IA; catalogo-padrao = degradacao controlada (IA fora, lenta ou com erro).",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (origem) (rate(gamificacao_recomendacao_total[1m]))", "legendFormat": "{{origem}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}, "overrides": []}
    },
    {
      "id": 8, "type": "timeseries", "title": "ADR-003 · Latencia da chamada a IA (max) x timeout de 1,5 s",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "max by (resultado) (gamificacao_recomendacao_ia_seconds_max)", "legendFormat": "{{resultado}}"},
        {"refId": "B", "expr": "vector(1.5)", "legendFormat": "timeout de leitura"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": []}
    },
    {
      "id": 9, "type": "timeseries", "title": "Fluxo essencial · latencia p95 por rota",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/api/.*\"}[1m])))", "legendFormat": "{{uri}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": []}
    },
    {
      "id": 10, "type": "timeseries", "title": "ADR-005 · Eventos IoT por resultado (por minuto)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (resultado) (increase(gamificacao_iot_eventos_total[1m]))", "legendFormat": "{{resultado}}"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 60}}, "overrides": []}
    },
    {
      "id": 11, "type": "timeseries", "title": "Confiabilidade · respostas HTTP 5xx do Core (req/s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) or vector(0)", "legendFormat": "5xx"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": []}
    }
  ]
}
