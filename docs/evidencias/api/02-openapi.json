{
  "openapi": "3.1.0",
  "info": {
    "title": "Educacao Continuada Gamificada - API do Forum",
    "description": "API da US1 do Grupo 12: \"EU COMO aluno assinante da plataforma QUERO ser o que mais escreve topicos e ajuda outros participantes no forum PARA ganhar um curso no final do mes.\"\n\nA regra de premiacao fica no pacote `domain`, construido por TDD (ciclo RED / GREEN / BLUE, 100% de cobertura).",
    "contact": {
      "name": "Grupo 12 - Caua Tolentino, Pedro Pizzi, Henry Tanaka"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Forum",
      "description": "US1 - premiacao do aluno com maior engajamento no forum"
    }
  ],
  "paths": {
    "/api/participacoes": {
      "post": {
        "tags": [
          "Forum"
        ],
        "summary": "Registra a participacao de um aluno no forum no mes",
        "operationId": "registrarParticipacao",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovaParticipacaoDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Participacao registrada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ParticipacaoDTO"
                }
              }
            }
          },
          "400": {
            "description": "Quantidade negativa ou mes invalido",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ParticipacaoDTO"
                }
              }
            }
          },
          "404": {
            "description": "Aluno nao cadastrado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ParticipacaoDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/forum/encerrar-mes": {
      "post": {
        "tags": [
          "Forum"
        ],
        "summary": "Encerra o mes e premia com 1 curso o aluno de maior engajamento",
        "description": "Se nao houve nenhuma participacao no mes, ninguem e premiado.",
        "operationId": "encerrarMes",
        "parameters": [
          {
            "name": "mes",
            "in": "query",
            "description": "Mes de referencia no formato AAAA-MM",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2026-09"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PremiacaoDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/alunos": {
      "get": {
        "tags": [
          "Forum"
        ],
        "summary": "Lista os alunos e quantos cursos cada um ja ganhou",
        "operationId": "listarAlunos",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlunoDTO"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Forum"
        ],
        "summary": "Cadastra um aluno assinante",
        "operationId": "cadastrarAluno",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NovoAlunoDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Aluno cadastrado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlunoDTO"
                }
              }
            }
          },
          "400": {
            "description": "Nome em branco ou aluno ja cadastrado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlunoDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/forum/engajamento": {
      "get": {
        "tags": [
          "Forum"
        ],
        "summary": "Ranking de engajamento do mes, do maior para o menor",
        "operationId": "engajamentoDoMes",
        "parameters": [
          {
            "name": "mes",
            "in": "query",
            "description": "Mes de referencia no formato AAAA-MM",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "2026-09"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ParticipacaoDTO"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NovaParticipacaoDTO": {
        "type": "object",
        "properties": {
          "nomeAluno": {
            "type": "string"
          },
          "topicosEscritos": {
            "type": "integer",
            "format": "int32"
          },
          "comentariosAjuda": {
            "type": "integer",
            "format": "int32"
          },
          "mesReferencia": {
            "type": "string"
          }
        }
      },
      "ParticipacaoDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nomeAluno": {
            "type": "string"
          },
          "topicosEscritos": {
            "type": "integer",
            "format": "int32"
          },
          "comentariosAjuda": {
            "type": "integer",
            "format": "int32"
          },
          "engajamento": {
            "type": "integer",
            "format": "int32"
          },
          "mesReferencia": {
            "type": "string"
          }
        }
      },
      "PremiacaoDTO": {
        "type": "object",
        "properties": {
          "mesReferencia": {
            "type": "string"
          },
          "houvePremiacao": {
            "type": "boolean"
          },
          "alunoPremiado": {
            "type": "string"
          },
          "engajamento": {
            "type": "integer",
            "format": "int32"
          },
          "cursosGanhos": {
            "type": "integer",
            "format": "int32"
          },
          "mensagem": {
            "type": "string"
          }
        }
      },
      "NovoAlunoDTO": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          }
        }
      },
      "AlunoDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nome": {
            "type": "string"
          },
          "cursosGanhos": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}